# First upload uses an explicit allowlist. Review this file when adding sources.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/docs/
/docs/*
!/docs/GITHUB_UPLOAD.md
!/system1_backend/
/system1_backend/*
!/system1_backend/main.py
!/system1_backend/receiver_tracking.py
!/system2_backend/
/system2_backend/*
!/system2_backend/main.py
!/system2_backend/simulation_receiver.py
!/system2_backend/event_validation.py
!/system2_backend/simulation_storage.py
!/system2_backend/test_step34_storage.py
!/system2_backend/test_step24.py
!/system2_backend/test_step25.py
!/system2_backend/test_step27.py
!/system2_backend/test_step28.py

# Never commit environments, credentials, runtime output or personal records.
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*.json
**/*service-account*.json
**/*.log
**/STEP*_payloads.json
**/STEP*_two_process_payloads.json
**/STEP*_test_results.txt
**/STEP*_integrity.json
**/STEP*_existing_servers.json
/.idea/
/.vscode/
/.aws/
/.codex/
/.agents/
